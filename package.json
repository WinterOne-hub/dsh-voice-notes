{
  "name": "dsh-voice-notes",
  "version": "0.0.2",
  "type": "module",
  "description": "语音速记 · 录音转文字 / Voice Notes: local audio transcription, meeting summaries, and transcript sharing for DeepSeek Harness Desktop",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "storage.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "PRIVACY.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "voice-notes",
    "speech-to-text",
    "audio-transcription",
    "asr",
    "dictation",
    "meeting-notes",
    "transcript-search",
    "语音速记",
    "录音转写",
    "语音转文字",
    "语音识别",
    "会议纪要",
    "本地录音"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WinterOne-hub/dsh-voice-notes.git"
  },
  "homepage": "https://github.com/WinterOne-hub/dsh-voice-notes#readme"
}
