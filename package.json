{
  "name": "dsh-voice-notes",
  "version": "0.0.8",
  "type": "module",
  "description": "DeepSeek Harness 本地录音转写、电脑声音录制、学习笔记和会议分析 / Local transcription, computer audio, learning notes and meeting analysis for DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "storage.js",
    "meeting.js",
    "meeting-check.js",
    "meeting-interpretation.js",
    "meeting-worker.js",
    "meeting-models/segmentation.onnx",
    "meeting-models/LICENSE",
    "windows-private-directory.js",
    "updater.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "PRIVACY.md",
    "LICENSE",
    "NOTICE.md",
    "pcm.js",
    "system-audio.js",
    "native/macos/*",
    "native/windows/*",
    "scripts/build-system-audio.mjs",
    "native/bin/darwin-arm64.json",
    "native/bin/darwin-arm64/VoiceNotesAudio.app/Contents/Info.plist",
    "native/bin/darwin-arm64/VoiceNotesAudio.app/Contents/MacOS/VoiceNotesAudio",
    "native/bin/darwin-arm64/VoiceNotesAudio.app/Contents/_CodeSignature/CodeResources",
    "native/bin/win32-x64.json",
    "native/bin/win32-x64/system-audio.exe"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin",
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test",
    "build:native": "node scripts/build-system-audio.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "voice-notes",
    "speech-to-text",
    "audio-transcription",
    "offline-transcription",
    "local-asr",
    "voice-dictation",
    "speaker-diarization",
    "multi-speaker",
    "meeting-transcription",
    "meeting-notes",
    "meeting-summary",
    "transcript-search",
    "语音速记",
    "录音转文字",
    "录音转写",
    "本地转写",
    "语音输入",
    "语音听写",
    "多人会议",
    "说话人分离",
    "会议记录",
    "会议纪要",
    "转写检索",
    "asr",
    "dictation",
    "语音转文字",
    "语音识别",
    "本地录音",
    "system-audio",
    "wasapi-loopback",
    "learning-notes",
    "电脑声音录制",
    "会议体检",
    "潜台词"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WinterOne-hub/dsh-voice-notes.git"
  },
  "homepage": "https://github.com/WinterOne-hub/dsh-voice-notes#readme"
}
